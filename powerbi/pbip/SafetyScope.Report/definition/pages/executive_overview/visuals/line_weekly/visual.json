{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "line_weekly",
  "position": {
    "x": 640,
    "y": 150,
    "z": 7,
    "width": 620,
    "height": 300,
    "tabOrder": 7
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Calendar.Month",
              "nativeQueryRef": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Alerts"
                    }
                  },
                  "Property": "Total Alerts"
                }
              },
              "queryRef": "Alerts.Total Alerts",
              "nativeQueryRef": "Total Alerts"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}