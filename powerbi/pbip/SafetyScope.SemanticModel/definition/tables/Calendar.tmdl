table Calendar
	lineageTag: 65d1c33d-13d2-5622-ac6a-52a3fcf74bcb
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: c6bffc92-5dc1-5b13-9ee1-e2ec2e96d11b
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 8bd6ad2f-058f-5e53-8952-0e9c1545b674
		summarizeBy: none
		sourceColumn: Year

	column 'Month Number'
		dataType: int64
		formatString: 0
		lineageTag: 0ea624f5-4bcb-56a7-8539-d7214131219d
		summarizeBy: none
		sourceColumn: Month Number

	column Month
		dataType: string
		lineageTag: f3703c39-b4b1-515c-84ca-700805908a9a
		summarizeBy: none
		sourceColumn: Month

	column Quarter
		dataType: string
		lineageTag: f1b7517c-b4e6-5304-a036-57a9aaafc912
		summarizeBy: none
		sourceColumn: Quarter

	partition Calendar = m
		mode: import
		source =
				let
				    StartDate = #date(2020, 1, 1),
				    EndDate = #date(2026, 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    AsTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(AsTable, {{"Date", type date}}),
				    AddYear = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				    AddMonthNo = Table.AddColumn(AddYear, "Month Number", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], "yyyy-MM"), type text),
				    AddQuarter = Table.AddColumn(AddMonth, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])) & " " & Text.From(Date.Year([Date])), type text)
				in
				    AddQuarter
