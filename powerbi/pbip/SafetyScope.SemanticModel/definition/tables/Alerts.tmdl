table Alerts
	lineageTag: 127ba64c-03da-58c1-810b-ebf6a354fa04

	/// Number of distinct Safety Gate alerts in the current filter context.
	measure 'Total Alerts' = DISTINCTCOUNT(Alerts[alert_number])
		formatString: #,0
		lineageTag: 4e2824e9-aff7-5e13-b729-4e032e3221c0

	/// Alerts as a share of all alerts in the current slicer selection.
	measure 'Share of Selected Alerts' = DIVIDE([Total Alerts], CALCULATE([Total Alerts], ALLSELECTED()))
		formatString: 0.0%
		lineageTag: 2e7db35d-1155-514a-a044-1a1f9eb1db72

	/// Alerts whose risk text names BMHCA (butylphenyl methylpropional).
	measure 'BMHCA Alerts' = CALCULATE([Total Alerts], AlertSubstances[substance] = "Butylphenyl methylpropional")
		formatString: #,0
		lineageTag: cea6f82f-800e-531e-a153-d0739eda6423

	/// Share of alerts naming BMHCA.
	measure 'BMHCA Share' = DIVIDE([BMHCA Alerts], [Total Alerts])
		formatString: 0.0%
		lineageTag: 6b894440-db7d-5ff6-b0d6-c98460de21bd

	/// Number of distinct chemical substances named.
	measure 'Distinct Chemicals' = CALCULATE(DISTINCTCOUNT(AlertSubstances[substance]), Substances[agent_type] = "chemical")
		formatString: #,0
		lineageTag: 0c27f689-89a9-5082-961d-5b0cf2301068

	/// Alert-substance pairs. Larger than Total Alerts when alerts name several substances.
	measure 'Substance Mentions' = COUNTROWS(AlertSubstances)
		formatString: #,0
		lineageTag: c60c0da7-4cab-51f5-a57e-32457fe62ad0

	/// Distinct notifying countries.
	measure 'Notifying Countries' = DISTINCTCOUNT(Alerts[notifying_country])
		formatString: #,0
		lineageTag: 15393c7c-fb61-569b-ae31-c90c3ea1f486

	/// Share of alerts whose risk text says the finding is based on the list of ingredients.
	measure 'Ingredient-List Based %' = DIVIDE(CALCULATE([Total Alerts], Alerts[based_on_ingredient_list] = TRUE()), [Total Alerts])
		formatString: 0.0%
		lineageTag: 1ba934ed-3981-5b64-9370-dccc47e544d8

	/// Share of alerts reporting a measured value.
	measure 'Lab Measurement %' = DIVIDE(CALCULATE([Total Alerts], Alerts[has_measured_value] = TRUE()), [Total Alerts])
		formatString: 0.0%
		lineageTag: ca790712-b0d3-58bc-8c95-6a145c853e67

	/// Share of alerts with unknown country of origin.
	measure 'Origin Unknown %' = DIVIDE(CALCULATE([Total Alerts], Alerts[origin_country] = "Unknown"), [Total Alerts])
		formatString: 0.0%
		lineageTag: 07e838b1-d92f-59d5-8055-7271202022d7

	/// Median days from the first measure's entry into force to the weekly report.
	measure 'Median Days Measure to Report' = MEDIAN(Alerts[days_measure_to_report])
		formatString: #,0
		lineageTag: 36508c23-9723-5aee-b250-8a99ac5549f6

	/// Alerts with at least one ban-on-marketing measure.
	measure 'Alerts with Ban on Marketing' = CALCULATE([Total Alerts], CorrectiveMeasures[measure_group] = "Ban on marketing", CROSSFILTER(CorrectiveMeasures[alert_number], Alerts[alert_number], Both))
		formatString: #,0
		lineageTag: 582911a9-97af-56b3-aff8-1f1f65020608

	/// Alerts with at least one recall from end users.
	measure 'Alerts with Recall' = CALCULATE([Total Alerts], CorrectiveMeasures[measure_group] = "Recall from end users", CROSSFILTER(CorrectiveMeasures[alert_number], Alerts[alert_number], Both))
		formatString: #,0
		lineageTag: f54d522c-0347-56cf-b993-97146ab47c7b

	/// Share of alerts with a recall.
	measure 'Recall %' = DIVIDE([Alerts with Recall], [Total Alerts])
		formatString: 0.0%
		lineageTag: c487d157-4f73-59ba-bc9f-bba3e1c0b8d9

	/// Alerts with at least one company-initiated (voluntary) measure.
	measure 'Alerts with Voluntary Measure' = CALCULATE([Total Alerts], CorrectiveMeasures[measure_kind] = "voluntary", CROSSFILTER(CorrectiveMeasures[alert_number], Alerts[alert_number], Both))
		formatString: #,0
		lineageTag: 0738a364-4fdc-5817-9d60-238eac844dd5

	/// Number of measures (not alerts). Use Total Alerts for alert counts.
	measure 'Measure Rows' = COUNTROWS(CorrectiveMeasures)
		formatString: #,0
		lineageTag: 048010fc-dcbf-5672-a21f-58c67bfdb9d1

	/// Average alerts per weekly report in the selection.
	measure 'Alerts per Weekly Report' = AVERAGEX(VALUES(Alerts[weekly_report]), [Total Alerts])
		formatString: #,0.0
		lineageTag: 7f50dc3d-1e25-5ffe-ba05-b8adb5327121

