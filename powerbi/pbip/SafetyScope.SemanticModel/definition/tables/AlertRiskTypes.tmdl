table AlertRiskTypes
	lineageTag: a91d7df2-d5ed-5d63-8090-73498002f1cb

	column alert_number
		dataType: string
		lineageTag: 13a2e7da-cd7d-5950-83b5-30d22189206f
		summarizeBy: none
